{
  "Service": {
    "TickIntervalSeconds": 2,
    "GracefulCloseTimeoutSeconds": 5,
    "MaxConcurrentPipeConnections": 4
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
