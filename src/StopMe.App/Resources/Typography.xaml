<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        StopMe — typography (per the 2026-06 design handoff).

        UI: Schibsted Grotesk (Google Fonts). Display/serif accents: Instrument Serif.
        Neither is installed in the dev environment; the comma-separated fallback
        chain resolves to the closest system font (Segoe UI Variable Display for sans,
        Cambria for the serif accents). Phase 7 packaging will embed the actual TTFs.
    -->

    <FontFamily x:Key="StopMeSansFontFamily">Schibsted Grotesk, Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="StopMeSerifFontFamily">Instrument Serif, Cambria, Georgia, Times New Roman</FontFamily>
    <FontFamily x:Key="StopMeMonoFontFamily">Consolas, Cascadia Mono, Courier New</FontFamily>

    <!-- ===== Type scale (per tokens table in the README) ===== -->

    <!-- Hero (serif) — Dashboard "What do you want to block?", browser blocked page -->
    <Style x:Key="StopMeHeroSerif" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StopMeSerifFontFamily}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="50" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource StopMeTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Page title — 26 / 700 / -0.02em -->
    <Style x:Key="StopMePageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StopMeSansFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource StopMeTextPrimaryBrush}" />
    </Style>

    <!-- Section title — 17 / 700 / -0.01em -->
    <Style x:Key="StopMeSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StopMeSansFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource StopMeTextPrimaryBrush}" />
    </Style>

    <!-- Card title — 15 / 700 -->
    <Style x:Key="StopMeCardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StopMeSansFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource StopMeTextPrimaryBrush}" />
    </Style>

    <!-- Body — 14 / 400 — default text -->
    <Style x:Key="StopMeBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StopMeSansFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource StopMeTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StopMeBodyStrong" TargetType="TextBlock" BasedOn="{StaticResource StopMeBody}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="StopMeBodySecondary" TargetType="TextBlock" BasedOn="{StaticResource StopMeBody}">
        <Setter Property="Foreground" Value="{ThemeResource StopMeTextSecondaryBrush}" />
    </Style>

    <Style x:Key="StopMeBodyTertiary" TargetType="TextBlock" BasedOn="{StaticResource StopMeBody}">
        <Setter Property="Foreground" Value="{ThemeResource StopMeTextTertiaryBrush}" />
    </Style>

    <!-- Small label — 12.5 -->
    <Style x:Key="StopMeSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StopMeSansFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource StopMeTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StopMeSmallTertiary" TargetType="TextBlock" BasedOn="{StaticResource StopMeSmall}">
        <Setter Property="Foreground" Value="{ThemeResource StopMeTextTertiaryBrush}" />
    </Style>

    <!-- Eyebrow label — 12 / 700 / uppercase / 0.06em — used above duration selector etc. -->
    <Style x:Key="StopMeEyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StopMeSansFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{ThemeResource StopMeTextTertiaryBrush}" />
    </Style>

    <!-- Badge — 11 / 700 / 0.02em -->
    <Style x:Key="StopMeBadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StopMeSansFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="20" />
    </Style>

    <!-- Countdown — tabular-nums, -0.03em -->
    <Style x:Key="StopMeCountdown" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StopMeSansFontFamily}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-30" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
        <Setter Property="Foreground" Value="{ThemeResource StopMeTextPrimaryBrush}" />
    </Style>

    <!-- Wordmark — sidebar logo "StopMe" — 17 / 700 / -0.02em -->
    <Style x:Key="StopMeWordmark" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StopMeSansFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource StopMeTextPrimaryBrush}" />
    </Style>

    <!-- Mono — process names, paths -->
    <Style x:Key="StopMeMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StopMeMonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource StopMeTextTertiaryBrush}" />
    </Style>

    <!-- Serif italic quote — used on the browser blocked page -->
    <Style x:Key="StopMeSerifQuote" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StopMeSerifFontFamily}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{ThemeResource StopMeTextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== Legacy aliases — keep older XAML compiling while it migrates ===== -->
    <Style x:Key="StopMeDisplay" TargetType="TextBlock" BasedOn="{StaticResource StopMeHeroSerif}" />
    <Style x:Key="StopMeTitle"   TargetType="TextBlock" BasedOn="{StaticResource StopMePageTitle}" />
    <Style x:Key="StopMeSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource StopMeEyebrow}" />
    <Style x:Key="StopMeCaption"  TargetType="TextBlock" BasedOn="{StaticResource StopMeSmall}" />
    <Style x:Key="StopMeCode"     TargetType="TextBlock" BasedOn="{StaticResource StopMeMono}" />

</ResourceDictionary>
