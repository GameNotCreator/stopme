<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        StopMe — design tokens (per the 2026-06 design handoff).

        Locked to Light theme only: white-dominant surfaces, sober violet accent.
        ElementTheme is forced to Light in MainWindow so these brushes apply on
        every system. The tokens map 1:1 to the CSS variables in
        design_handoff_stopme/prototype/stopme.css.
    -->

    <!-- ===== Color tokens ===== -->
    <Color x:Key="StopMeColorBgPrimary">#FFFFFFFF</Color>
    <Color x:Key="StopMeColorBgSecondary">#FFF6F5FA</Color>
    <Color x:Key="StopMeColorBgTertiary">#FFEFEDF6</Color>
    <Color x:Key="StopMeColorBgApp">#FFF3F2F8</Color>

    <Color x:Key="StopMeColorTextPrimary">#FF17151F</Color>
    <Color x:Key="StopMeColorTextSecondary">#FF6E6A7C</Color>
    <Color x:Key="StopMeColorTextTertiary">#FF9B97AA</Color>

    <Color x:Key="StopMeColorAccent">#FF7C5CFF</Color>
    <Color x:Key="StopMeColorAccentHover">#FF6A4AF0</Color>
    <Color x:Key="StopMeColorAccentActive">#FF5C3CE0</Color>
    <Color x:Key="StopMeColorAccentSoft">#FFF1ECFF</Color>
    <Color x:Key="StopMeColorAccentSoft2">#FFE4DCFF</Color>
    <Color x:Key="StopMeColorAccentText">#FF6442E8</Color>

    <Color x:Key="StopMeColorSuccess">#FF1F8A5B</Color>
    <Color x:Key="StopMeColorSuccessSoft">#FFE5F4EC</Color>
    <Color x:Key="StopMeColorWarning">#FFB97B0A</Color>
    <Color x:Key="StopMeColorWarningSoft">#FFFBF2DF</Color>
    <Color x:Key="StopMeColorError">#FFCC4256</Color>
    <Color x:Key="StopMeColorErrorSoft">#FFFBEAED</Color>

    <Color x:Key="StopMeColorBorder">#FFE9E7F1</Color>
    <Color x:Key="StopMeColorBorderStrong">#FFDBD8E8</Color>

    <!-- ===== Brushes — backgrounds ===== -->
    <SolidColorBrush x:Key="StopMeBgPrimaryBrush"   Color="{StaticResource StopMeColorBgPrimary}" />
    <SolidColorBrush x:Key="StopMeBgSecondaryBrush" Color="{StaticResource StopMeColorBgSecondary}" />
    <SolidColorBrush x:Key="StopMeBgTertiaryBrush"  Color="{StaticResource StopMeColorBgTertiary}" />
    <SolidColorBrush x:Key="StopMeBgAppBrush"       Color="{StaticResource StopMeColorBgApp}" />

    <!-- ===== Brushes — text ===== -->
    <SolidColorBrush x:Key="StopMeTextPrimaryBrush"   Color="{StaticResource StopMeColorTextPrimary}" />
    <SolidColorBrush x:Key="StopMeTextSecondaryBrush" Color="{StaticResource StopMeColorTextSecondary}" />
    <SolidColorBrush x:Key="StopMeTextTertiaryBrush"  Color="{StaticResource StopMeColorTextTertiary}" />

    <!-- ===== Brushes — accent ===== -->
    <SolidColorBrush x:Key="StopMeAccentBrush"       Color="{StaticResource StopMeColorAccent}" />
    <SolidColorBrush x:Key="StopMeAccentHoverBrush"  Color="{StaticResource StopMeColorAccentHover}" />
    <SolidColorBrush x:Key="StopMeAccentActiveBrush" Color="{StaticResource StopMeColorAccentActive}" />
    <SolidColorBrush x:Key="StopMeAccentSoftBrush"   Color="{StaticResource StopMeColorAccentSoft}" />
    <SolidColorBrush x:Key="StopMeAccentSoft2Brush"  Color="{StaticResource StopMeColorAccentSoft2}" />
    <SolidColorBrush x:Key="StopMeAccentTextBrush"   Color="{StaticResource StopMeColorAccentText}" />

    <!-- Logo / strict gradient — accent → accent-active, 140 degree -->
    <LinearGradientBrush x:Key="StopMeAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource StopMeColorAccent}" />
        <GradientStop Offset="1" Color="{StaticResource StopMeColorAccentActive}" />
    </LinearGradientBrush>

    <!-- ===== Brushes — semantic ===== -->
    <SolidColorBrush x:Key="StopMeSuccessBrush"     Color="{StaticResource StopMeColorSuccess}" />
    <SolidColorBrush x:Key="StopMeSuccessSoftBrush" Color="{StaticResource StopMeColorSuccessSoft}" />
    <SolidColorBrush x:Key="StopMeWarningBrush"     Color="{StaticResource StopMeColorWarning}" />
    <SolidColorBrush x:Key="StopMeWarningSoftBrush" Color="{StaticResource StopMeColorWarningSoft}" />
    <SolidColorBrush x:Key="StopMeErrorBrush"       Color="{StaticResource StopMeColorError}" />
    <SolidColorBrush x:Key="StopMeErrorSoftBrush"   Color="{StaticResource StopMeColorErrorSoft}" />

    <!-- ===== Brushes — borders ===== -->
    <SolidColorBrush x:Key="StopMeBorderBrush"       Color="{StaticResource StopMeColorBorder}" />
    <SolidColorBrush x:Key="StopMeBorderStrongBrush" Color="{StaticResource StopMeColorBorderStrong}" />

    <!-- ===== Strict ===== -->
    <SolidColorBrush x:Key="StopMeStrictBrush"       Color="{StaticResource StopMeColorTextPrimary}" />
    <SolidColorBrush x:Key="StopMeStrictTextBrush"   Color="{StaticResource StopMeColorBgPrimary}" />

    <!-- ===== WinUI brush overrides — propagate violet/white into stock controls ===== -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource StopMeColorBgApp}" />
    <SolidColorBrush x:Key="SystemControlAcrylicWindowBrush"     Color="{StaticResource StopMeColorBgApp}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"          Color="{StaticResource StopMeColorBgPrimary}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource StopMeColorBgPrimary}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"         Color="{StaticResource StopMeColorBorder}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"           Color="{StaticResource StopMeColorTextPrimary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"         Color="{StaticResource StopMeColorTextSecondary}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"          Color="{StaticResource StopMeColorTextTertiary}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"     Color="{StaticResource StopMeColorAccent}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"         Color="{StaticResource StopMeColorAccent}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"       Color="{StaticResource StopMeColorAccentHover}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"        Color="{StaticResource StopMeColorAccentActive}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"        Color="{StaticResource StopMeColorBgPrimary}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"      Color="{StaticResource StopMeColorBgSecondary}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"       Color="{StaticResource StopMeColorBgTertiary}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"      Color="{StaticResource StopMeColorBorderStrong}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"      Color="{StaticResource StopMeColorBorder}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnBrush"             Color="{StaticResource StopMeColorAccent}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOverBrush"  Color="{StaticResource StopMeColorAccentHover}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressedBrush"      Color="{StaticResource StopMeColorAccentActive}" />

    <!-- ===== Back-compat aliases used by older XAML — point to new violet tokens ===== -->
    <SolidColorBrush x:Key="StopMeBackgroundBrush"          Color="{StaticResource StopMeColorBgApp}" />
    <SolidColorBrush x:Key="StopMeForegroundBrush"          Color="{StaticResource StopMeColorTextPrimary}" />
    <SolidColorBrush x:Key="StopMeCardBrush"                Color="{StaticResource StopMeColorBgPrimary}" />
    <SolidColorBrush x:Key="StopMeCardForegroundBrush"      Color="{StaticResource StopMeColorTextPrimary}" />
    <SolidColorBrush x:Key="StopMePopoverBrush"             Color="{StaticResource StopMeColorBgPrimary}" />
    <SolidColorBrush x:Key="StopMeMutedBrush"               Color="{StaticResource StopMeColorBgSecondary}" />
    <SolidColorBrush x:Key="StopMeMutedForegroundBrush"     Color="{StaticResource StopMeColorTextSecondary}" />
    <SolidColorBrush x:Key="StopMeInputBrush"               Color="{StaticResource StopMeColorBorderStrong}" />
    <SolidColorBrush x:Key="StopMePrimaryBrush"             Color="{StaticResource StopMeColorAccent}" />
    <SolidColorBrush x:Key="StopMePrimaryForegroundBrush"   Color="{StaticResource StopMeColorBgPrimary}" />
    <SolidColorBrush x:Key="StopMeSecondaryBrush"           Color="{StaticResource StopMeColorAccentSoft}" />
    <SolidColorBrush x:Key="StopMeSecondaryForegroundBrush" Color="{StaticResource StopMeColorAccentText}" />
    <SolidColorBrush x:Key="StopMeAccentForegroundBrush"    Color="{StaticResource StopMeColorAccentText}" />
    <SolidColorBrush x:Key="StopMeRingBrush"                Color="{StaticResource StopMeColorAccent}" />
    <SolidColorBrush x:Key="StopMeDestructiveBrush"             Color="{StaticResource StopMeColorError}" />
    <SolidColorBrush x:Key="StopMeDestructiveForegroundBrush"   Color="{StaticResource StopMeColorBgPrimary}" />
    <SolidColorBrush x:Key="StopMeSidebarBrush"                  Color="{StaticResource StopMeColorBgApp}" />
    <SolidColorBrush x:Key="StopMeSidebarForegroundBrush"        Color="{StaticResource StopMeColorTextPrimary}" />
    <SolidColorBrush x:Key="StopMeSidebarPrimaryBrush"           Color="{StaticResource StopMeColorAccent}" />
    <SolidColorBrush x:Key="StopMeSidebarPrimaryForegroundBrush" Color="{StaticResource StopMeColorBgPrimary}" />
    <SolidColorBrush x:Key="StopMeSidebarAccentBrush"            Color="{StaticResource StopMeColorAccent}" />
    <SolidColorBrush x:Key="StopMeSidebarAccentForegroundBrush"  Color="{StaticResource StopMeColorBgPrimary}" />
    <SolidColorBrush x:Key="StopMeSidebarBorderBrush"            Color="{StaticResource StopMeColorBorder}" />
    <SolidColorBrush x:Key="StopMeSidebarRingBrush"              Color="{StaticResource StopMeColorAccent}" />
    <SolidColorBrush x:Key="StopMeChart1Brush" Color="{StaticResource StopMeColorAccent}" />
    <SolidColorBrush x:Key="StopMeChart2Brush" Color="#FF9C8DF0" />
    <SolidColorBrush x:Key="StopMeChart3Brush" Color="#FFC9C0F7" />
    <SolidColorBrush x:Key="StopMeChart4Brush" Color="{StaticResource StopMeColorTextTertiary}" />
    <SolidColorBrush x:Key="StopMeChart5Brush" Color="{StaticResource StopMeColorAccentSoft2}" />

    <!-- ===== Radii (design tokens) ===== -->
    <CornerRadius x:Key="StopMeRadiusCard">20</CornerRadius>
    <CornerRadius x:Key="StopMeRadiusCardLg">24</CornerRadius>
    <CornerRadius x:Key="StopMeRadiusButton">12</CornerRadius>
    <CornerRadius x:Key="StopMeRadiusInput">12</CornerRadius>
    <CornerRadius x:Key="StopMeRadiusPill">999</CornerRadius>
    <CornerRadius x:Key="StopMeRadiusPanelTopLeft">20,0,0,0</CornerRadius>

    <!-- Back-compat radii / padding -->
    <CornerRadius x:Key="StopMeCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="StopMeCardRadius">20</CornerRadius>
    <Thickness    x:Key="StopMeCardPadding">24,20,24,20</Thickness>
    <Thickness    x:Key="StopMePagePadding">40,36,40,48</Thickness>

    <!-- ===== Spacing scale (8px base) ===== -->
    <x:Double x:Key="StopMeSp1">4</x:Double>
    <x:Double x:Key="StopMeSp2">8</x:Double>
    <x:Double x:Key="StopMeSp3">12</x:Double>
    <x:Double x:Key="StopMeSp4">16</x:Double>
    <x:Double x:Key="StopMeSp5">24</x:Double>
    <x:Double x:Key="StopMeSp6">32</x:Double>
    <x:Double x:Key="StopMeSp7">40</x:Double>
    <x:Double x:Key="StopMeSp8">56</x:Double>

</ResourceDictionary>
