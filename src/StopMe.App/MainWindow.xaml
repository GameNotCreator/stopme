<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StopMe.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StopMe.App.Controls"
    xmlns:models="using:StopMe.App.Core.Models"
    Title="StopMe">

    <Grid x:Name="RootGrid" Background="{ThemeResource StopMeBgAppBrush}" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ====== Custom title bar — transparent, drag-region + right-aligned caption buttons ====== -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Background="{ThemeResource StopMeBgAppBrush}"
              VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Drag region: empty space the OS treats as the title-bar drag handle -->
            <Border Grid.Column="0" Background="Transparent" />

            <!-- Caption buttons — minimize / maximize / close (46x38, per spec) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource StopMeCaptionButton}"
                        Click="OnMinimizeClick">
                    <controls:IconGlyph Name="minus" Size="16" />
                </Button>
                <Button x:Name="MaximizeButton"
                        Style="{StaticResource StopMeCaptionButton}"
                        Click="OnMaximizeClick">
                    <controls:IconGlyph Name="maximize" Size="13" />
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource StopMeCloseCaptionButton}"
                        Click="OnCloseClick">
                    <controls:IconGlyph Name="x" Size="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ====== Shell: sidebar + main panel ====== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar — tinted: sits on bg-app, no border ===== -->
            <Grid Grid.Column="0" Padding="14,4,14,16" Background="{ThemeResource StopMeBgAppBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Padding="6,12,6,0" Margin="0,0,0,24">
                    <controls:LogoTile TileSize="30" />
                    <TextBlock Text="StopMe"
                               Style="{StaticResource StopMeWordmark}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Nav items -->
                <StackPanel x:Name="NavStack" Grid.Row="1" Spacing="3" />

                <!-- Mini active-session card (hidden when no session) -->
                <Border x:Name="SessionMiniCard"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Background="{ThemeResource StopMeAccentGradientBrush}"
                        CornerRadius="16"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,3">
                            <controls:StatusDot x:Name="MiniSessionStatusDot" Tone="success" Pulse="True" />
                            <TextBlock x:Name="MiniSessionLabel"
                                       Text="BLOCKING ACTIVE"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       CharacterSpacing="40"
                                       Opacity="0.85" />
                        </StackPanel>
                        <TextBlock x:Name="MiniSessionCountdown"
                                   Text="00:00"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   CharacterSpacing="-20" />
                        <TextBlock x:Name="MiniSessionEndsAt"
                                   Text=""
                                   FontSize="11.5"
                                   Foreground="White"
                                   Opacity="0.75" />
                    </StackPanel>
                </Border>

                <!-- Footer: service status chip + help -->
                <StackPanel Grid.Row="3" Spacing="3">
                    <Button x:Name="ServiceChipButton"
                            Style="{StaticResource StopMeNavItemButton}"
                            Click="OnServiceChipClick">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <controls:StatusDot x:Name="ServiceStatusDot" Tone="success" />
                            <TextBlock x:Name="ServiceStatusLabel"
                                       Text="Service connected"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource StopMeTextTertiaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StopMeNavItemButton}">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <controls:IconGlyph Name="help" Size="17" ForegroundBrush="{ThemeResource StopMeTextSecondaryBrush}" />
                            <TextBlock Text="Help"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource StopMeTextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== Main content panel — white, top-left 20px radius, thin border ===== -->
            <Border Grid.Column="1"
                    Background="{ThemeResource StopMeBgPrimaryBrush}"
                    BorderBrush="{ThemeResource StopMeBorderBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="20,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Connection banner — shown when service is connecting/down/auth/ext.
                         Layout matches the prototype's <ServiceBanner /> for the calm dashboard. -->
                    <Border x:Name="ConnectionBanner"
                            Grid.Row="0"
                            Visibility="Collapsed"
                            CornerRadius="16"
                            Margin="40,24,40,0"
                            BorderThickness="1"
                            Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing x:Name="ConnectionRing"
                                          Grid.Column="0"
                                          IsActive="True"
                                          Width="18" Height="18"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource StopMeTextSecondaryBrush}" />
                            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ConnectionTitle"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Text="Connecting to StopMe service…" />
                                <TextBlock x:Name="ConnectionBody"
                                           Style="{StaticResource StopMeBodySecondary}"
                                           FontSize="13"
                                           Margin="0,2,0,0"
                                           Text="This usually takes a couple of seconds." />
                            </StackPanel>
                            <Button x:Name="ReconnectButton"
                                    Grid.Column="2"
                                    Style="{StaticResource StopMeSecondaryButtonSmall}"
                                    Visibility="Collapsed"
                                    Click="OnReconnectClick"
                                    Content="Retry" />
                        </Grid>
                    </Border>

                    <!-- Page Frame — each page does its own padding/centering so the
                         shell stays variant-agnostic (cf. Dashboard "calm" vs Block-Apps "wide"). -->
                    <Frame x:Name="ContentFrame" Grid.Row="1" Background="Transparent" />
                </Grid>
            </Border>
        </Grid>

        <!-- Mini toast surface (in-app feedback) -->
        <controls:MiniToast x:Name="Toast"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" />
    </Grid>
</Window>
