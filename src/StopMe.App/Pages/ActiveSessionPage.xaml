<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StopMe.App.Pages.ActiveSessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dtos="using:StopMe.LocalApi.Dtos"
    Background="{ThemeResource StopMeBackgroundBrush}">

    <ScrollViewer Padding="{StaticResource StopMePagePadding}">
        <StackPanel Spacing="20" MaxWidth="780">
            <StackPanel Spacing="6">
                <TextBlock Text="ACTIVE SESSION" Style="{StaticResource StopMeSectionHeader}" />
                <TextBlock Text="What's blocking right now" Style="{StaticResource StopMeDisplay}" />
            </StackPanel>

            <Button Style="{StaticResource StopMePrimaryButton}"
                    Content="Refresh"
                    HorizontalAlignment="Left"
                    Click="OnRefreshClick" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ActiveSessionDto">
                        <Border Margin="0,8,0,0" Style="{StaticResource StopMeCard}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Style="{StaticResource StopMeTitle}" Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource StopMeCaption}">
                                        <Run Text="Until " />
                                        <Run Text="{x:Bind EndAtUtc}" />
                                        <Run Text=" UTC" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Style="{StaticResource StopMeBadge}">
                                        <TextBlock Text="{x:Bind Mode}" Style="{StaticResource StopMeCaption}" />
                                    </Border>
                                    <Border Style="{StaticResource StopMeBadge}"
                                            Background="{ThemeResource StopMeMutedBrush}">
                                        <TextBlock Text="{x:Bind LockPolicy}" Style="{StaticResource StopMeCaption}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Stop card -->
            <Border Style="{StaticResource StopMeCard}"
                    Visibility="{x:Bind ViewModel.Focused, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel Spacing="14">
                    <TextBlock Text="STOP SESSION" Style="{StaticResource StopMeSectionHeader}" />
                    <TextBlock Text="Requests a stop against the strict-mode policy." Style="{StaticResource StopMeBody}" />

                    <CheckBox Content="I confirm I want to stop"
                              IsChecked="{x:Bind ViewModel.UserConfirmed, Mode=TwoWay}" />
                    <TextBox PlaceholderText="Stop phrase (for RandomText lock)"
                             Style="{StaticResource StopMeTextBoxOutline}"
                             Text="{x:Bind ViewModel.TypedPhrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox PlaceholderText="Password (for Password lock)"
                                 Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />

                    <Button Style="{StaticResource StopMeDestructiveButton}"
                            Content="Stop session"
                            HorizontalAlignment="Left"
                            Click="OnStopClick" />
                </StackPanel>
            </Border>

            <Border Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Style="{StaticResource StopMeCard}"
                    Background="{ThemeResource StopMeDestructiveBrush}">
                <TextBlock Style="{StaticResource StopMeBody}"
                           Foreground="{ThemeResource StopMeDestructiveForegroundBrush}"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
