<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StopMe.App.Pages.TemplatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StopMe.App.Core.ViewModels"
    xmlns:dtos="using:StopMe.LocalApi.Dtos"
    Background="{ThemeResource StopMeBackgroundBrush}">

    <ScrollViewer Padding="{StaticResource StopMePagePadding}">
        <StackPanel Spacing="20" MaxWidth="1080" HorizontalAlignment="Stretch">

            <StackPanel Spacing="6">
                <TextBlock Text="TEMPLATES" Style="{StaticResource StopMeSectionHeader}" />
                <TextBlock Text="Start a focus recipe" Style="{StaticResource StopMeDisplay}" />
                <TextBlock Style="{StaticResource StopMeBody}"
                           Text="Each template seeds the blocklists it needs and queues a session immediately. You can edit either afterwards from Blocklists / Active session." />
            </StackPanel>

            <!-- Status banners -->
            <Border Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Style="{StaticResource StopMeCard}"
                    Background="{ThemeResource StopMeDestructiveBrush}">
                <TextBlock Style="{StaticResource StopMeBody}"
                           Foreground="{ThemeResource StopMeDestructiveForegroundBrush}"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </Border>

            <Border Visibility="{x:Bind ViewModel.LastAppliedSummary, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                    Style="{StaticResource StopMeCard}"
                    Background="{ThemeResource StopMeMutedBrush}">
                <TextBlock Style="{StaticResource StopMeBody}"
                           Text="{x:Bind ViewModel.LastAppliedSummary, Mode=OneWay}" />
            </Border>

            <!-- Schedule + Refresh controls -->
            <Border Style="{StaticResource StopMeCard}">
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
                               Text="SCHEDULE"
                               Style="{StaticResource StopMeSectionHeader}" />

                    <CalendarDatePicker Grid.Row="1" Grid.Column="0"
                                        Date="{x:Bind ViewModel.ScheduledStartDate, Mode=TwoWay}"
                                        PlaceholderText="Start date (optional)"
                                        MinWidth="200" />

                    <TimePicker Grid.Row="1" Grid.Column="1"
                                MinWidth="120"
                                MinuteIncrement="5"
                                SelectedTime="{x:Bind ViewModel.ScheduledStartTime, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="2"
                               VerticalAlignment="Center"
                               Style="{StaticResource StopMeCaption}"
                               Text="{x:Bind ViewModel.ScheduledStartLabel, Mode=OneWay}"
                               TextWrapping="Wrap" />

                    <Button Grid.Row="1" Grid.Column="3"
                            Style="{StaticResource StopMeGhostButton}"
                            Content="Apply immediately"
                            Click="OnClearScheduleClick" />

                    <Button Grid.Row="1" Grid.Column="4"
                            Style="{StaticResource StopMePrimaryButton}"
                            Content="Refresh"
                            Click="OnRefreshClick"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                </Grid>
            </Border>

            <!-- Templates list -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Templates, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="14" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dtos:TemplateDto">
                        <Border Style="{StaticResource StopMeCard}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Style="{StaticResource StopMeTitle}"
                                                   Text="{x:Bind DisplayName}" />
                                        <TextBlock Style="{StaticResource StopMeCaption}"
                                                   Text="{x:Bind Description}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Style="{StaticResource StopMeBadge}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Mode}" Style="{StaticResource StopMeCaption}" />
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource StopMeBadge}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind LockPolicy}" Style="{StaticResource StopMeCaption}" />
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource StopMeBadge}"
                                            VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource StopMeCaption}">
                                            <Run Text="{x:Bind DurationMinutes}" /><Run Text=" min" />
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{x:Bind Blocklists}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="dtos:TemplateBlocklistDto">
                                            <StackPanel Margin="0,4,0,0" Spacing="2">
                                                <TextBlock Style="{StaticResource StopMeBody}">
                                                    <Run Text="• " /><Run Text="{x:Bind Name}" />
                                                    <Run Text=" (" /><Run Text="{x:Bind Mode}" /><Run Text=")" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource StopMeCaption}"
                                                           Margin="14,0,0,0"
                                                           TextWrapping="Wrap"
                                                           Text="{x:Bind vm:TemplatesViewModel.FormatBlocklistPreview((dtos:TemplateBlocklistDto))}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid>
                                    <Button HorizontalAlignment="Right"
                                            Style="{StaticResource StopMePrimaryButton}"
                                            Content="Apply now"
                                            Click="OnApplyClick"
                                            Tag="{x:Bind Key}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource StopMeCaption}"
                       Text="No templates available."
                       Visibility="{x:Bind ViewModel.HasNoTemplates, Mode=OneWay}" />

        </StackPanel>
    </ScrollViewer>
</Page>
