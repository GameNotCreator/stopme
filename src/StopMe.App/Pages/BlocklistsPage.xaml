<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StopMe.App.Pages.BlocklistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dtos="using:StopMe.LocalApi.Dtos"
    Background="{ThemeResource StopMeBackgroundBrush}">

    <Grid Padding="{StaticResource StopMePagePadding}" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- List -->
        <StackPanel Grid.Column="0" Spacing="14">
            <TextBlock Text="BLOCKLISTS" Style="{StaticResource StopMeSectionHeader}" />
            <TextBlock Text="Your rule sets" Style="{StaticResource StopMeTitle}" />
            <Button Style="{StaticResource StopMePrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Content="Refresh"
                    Click="OnRefreshClick" />

            <ListView ItemsSource="{x:Bind ViewModel.Blocklists, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedBlocklist, Mode=TwoWay}"
                      SelectionMode="Single"
                      Background="{ThemeResource StopMeCardBrush}"
                      BorderBrush="{ThemeResource StopMeBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource StopMeCornerRadius}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:BlocklistDto">
                        <StackPanel Spacing="2" Padding="6,8">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource StopMeBody}" />
                            <TextBlock Style="{StaticResource StopMeCaption}">
                                <Run Text="{x:Bind Mode}" />
                                <Run Text=" · " />
                                <Run Text="{x:Bind Rules.Count}" />
                                <Run Text=" rules" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Right pane: detail + create -->
        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="18" MaxWidth="640" HorizontalAlignment="Left">

                <!-- Detail -->
                <Border Style="{StaticResource StopMeCard}"
                        Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="SELECTED BLOCKLIST" Style="{StaticResource StopMeSectionHeader}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedBlocklist.Name, Mode=OneWay}"
                                   Style="{StaticResource StopMeTitle}" />
                        <TextBlock Style="{StaticResource StopMeCaption}">
                            <Run Text="Mode: " />
                            <Run Text="{x:Bind ViewModel.SelectedBlocklist.Mode, Mode=OneWay}" />
                        </TextBlock>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedBlocklist.Rules, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dtos:BlockRuleDto">
                                    <Grid ColumnSpacing="12" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Style="{StaticResource StopMeBadge}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind Type}" Style="{StaticResource StopMeCaption}" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource StopMeCode}"
                                                   Text="{x:Bind Value}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource StopMeDestructiveButton}"
                                Content="Delete this blocklist"
                                HorizontalAlignment="Left"
                                Click="OnDeleteClick" />
                    </StackPanel>
                </Border>

                <!-- Create -->
                <Border Style="{StaticResource StopMeCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="NEW BLOCKLIST" Style="{StaticResource StopMeSectionHeader}" />
                        <TextBlock Text="Create a rule set" Style="{StaticResource StopMeTitle}" />

                        <TextBox PlaceholderText="Name (e.g. Social Media)"
                                 Style="{StaticResource StopMeTextBoxOutline}"
                                 Text="{x:Bind ViewModel.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox ItemsSource="{x:Bind ViewModel.Modes}"
                                  SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  Background="{ThemeResource StopMeCardBrush}"
                                  BorderBrush="{ThemeResource StopMeInputBrush}"
                                  CornerRadius="{StaticResource StopMeCornerRadius}" />

                        <TextBox PlaceholderText="One rule per line — domain, *.wildcard, allow:, category:, *.* "
                                 Style="{StaticResource StopMeTextBoxOutline}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 Text="{x:Bind ViewModel.NewRulesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Style="{StaticResource StopMePrimaryButton}"
                                Content="Create blocklist"
                                HorizontalAlignment="Left"
                                Click="OnCreateClick" />
                    </StackPanel>
                </Border>

                <Border Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Style="{StaticResource StopMeCard}"
                        Background="{ThemeResource StopMeDestructiveBrush}">
                    <TextBlock Style="{StaticResource StopMeBody}"
                               Foreground="{ThemeResource StopMeDestructiveForegroundBrush}"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
