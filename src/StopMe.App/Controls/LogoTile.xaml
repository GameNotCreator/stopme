<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StopMe.App.Controls.LogoTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Rounded violet gradient tile + a white hexagonal shield glyph.
         The white tones come from the gradient brush; the glyph itself is
         drawn via Path so it scales cleanly with the tile size. -->

    <Grid x:Name="Root" Width="30" Height="30">
        <Border x:Name="TileBorder"
                CornerRadius="9"
                Background="{ThemeResource StopMeAccentGradientBrush}" />
        <FontIcon x:Name="ShieldIcon"
                  Glyph="&#xEA18;"
                  FontFamily="Segoe MDL2 Assets"
                  Foreground="White"
                  FontSize="16"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
    </Grid>
</UserControl>
